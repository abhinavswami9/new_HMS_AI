<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../Careflow.Application/Careflow.Application.csproj" />
    <ProjectReference Include="../Careflow.Infrastructure/Careflow.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup><Content Include="../../database/migrations/*.sql" Link="migrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- The compiled React workspace (src/Careflow.Web/dist) ships inside the ASP.NET Core
       host as wwwroot so one .NET process serves the UI and the API. Build the web app
       first (npm run build) for the copy to happen; see docs/adr/0007. -->
  <Target Name="IncludeWebDist" BeforeTargets="AssignTargetPaths" Condition="Exists('$(MSBuildThisFileDirectory)../Careflow.Web/dist')">
    <ItemGroup>
      <_WebDist Include="$(MSBuildThisFileDirectory)../Careflow.Web/dist/**/*" />
      <ContentWithTargetPath Include="@(_WebDist)">
        <TargetPath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
